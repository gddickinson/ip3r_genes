# Python
__pycache__/
*.pyc
.venv/

# macOS
.DS_Store

# Opportunistic API cache (regenerates; can grow large)
cache/

# Bulk data lives at the data root (see data_root.txt), never in git.
# The local fallback directory is ignored wholesale:
data/

# Scratch
*.tmp
dashboard.html

# Generated illustrated findings page (rebuilt by scripts/build_findings_page.py;
# the markdown source is committed)
docs/findings_summary.html
docs/findings_summary.pdf

# --- regenerable run artefacts from the analysis toolchain -----------------
# IQ-TREE run checkpoints / parsimony start trees (churn mid-run)
results/phylogeny/**/*.ckp.gz
results/phylogeny/**/*.parstree

# PAML per-run scratch (regenerates with the run; not evidence). `mlc` is
# the primary output and is kept, along with codeml.ctl, the tree, the
# 2ML.* pairwise matrices and result.json — everything needed to re-check a
# run. `lnf` (per-site likelihoods) and `rst` grow with the site models.
results/selection/codeml/*/rub
results/selection/codeml/*/lnf
results/selection/codeml/*/rst
results/selection/codeml/*/rst1
results/selection/codeml/*/2NG.*
results/selection/codeml/*/RUNNING

# PAML scratch files if codeml is ever invoked from the repo root
/rst
/rst1
/rub
/2ML.*
/2NG.*
/lnf

# MAFFT / HyPhy progress logs — console noise, several MB, regenerable.
# The alignments, results and every derived TSV are committed.
results/constraint/mafft_*.log
results/constraint/fel/*.log

# S17's shape-screen intermediates. The screen needs a first alignment to
# measure each sequence's shape on (s17_orthologs.screen), so `_pass1` is a
# working file and not a result: the sequence it drops is named in
# `ortholog_shape.tsv`, the bar and both gap edges are in `align_stats.json`,
# and the SHA-256 of every input and output is recorded there — so the
# committed ortholog sets plus a `--thread 1` MAFFT (D24) regenerate it.
results/constraint/*_pass1.fasta
results/constraint/*_pass1.log

# Dashboard live-progress file: written continuously by whichever task is
# running, read by scripts/dashboard.py, meaningless once the task is done.
results/session_live.json

# IQ-TREE prefix locks (scripts/s7_run.py:claim) — process-local, never committed
results/**/*.lock

# IQ-TREE raw bootstrap tree sets — bulk, regenerable from the run;
# the consensus (.contree) and splits (.splits.nex) are what we keep
results/**/*.ufboot
